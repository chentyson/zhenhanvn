#!/bin/bash

# macOS system proxy helper.
#
# Root is used only for the networksetup calls that really change something:
#   1. every proxy state is read back with read-only networksetup commands (they need no root);
#   2. when the current state already equals the requested one the script exits 0 without ever
#      invoking sudo - this is the normal case when v2rayN restarts, because macOS keeps the
#      proxy settings from the previous session;
#   3. when something has to change it first tries `sudo -n` (a still-valid sudo timestamp or a
#      NOPASSWD sudoers entry), which again needs no password;
#   4. only if a change is needed and sudo cannot run without a prompt does it print
#      NEEDS_PASSWORD and exit 3 - the app's cue to ask the user for the administrator password
#      once and then call this script again with that password on the first line of stdin.
#
# Exit codes: 0 done (changed or nothing to do) | 3 administrator password required | other = failed.

NEEDS_PASSWORD_EXIT=3

SUDO_PWD=""
if [ ! -t 0 ]; then
    IFS= read -r SUDO_PWD || true
fi

# Run a command with sudo, feeding the password via stdin when one was supplied.
run_sudo() {
    if [ -n "$SUDO_PWD" ]; then
        printf '%s\n' "$SUDO_PWD" | sudo -S "$@"
    else
        sudo -n "$@"
    fi
}

# True when sudo can run right now without a password prompt.
can_sudo_without_password() {
    sudo -n true 2>/dev/null
}

# A change is required, but there is no password in hand and sudo is not authenticated:
# ask the app for the password instead of failing the run.
require_password_or_exit() {
    if [ -n "$SUDO_PWD" ] || can_sudo_without_password; then
        return 0
    fi

    echo "NEEDS_PASSWORD"
    exit "$NEEDS_PASSWORD_EXIT"
}

# Enabled network service names: drop the leading description line and skip the services
# marked with '*', which networksetup reports as disabled. Setting disabled or virtual
# services used to fail and report the whole run as failed even when the active service
# was configured correctly.
get_services() {
    networksetup -listallnetworkservices | tail -n +2 | grep -v '^\*'
}

# Check one "-get..." report: the proxy must be enabled and point at the expected server and port.
state_matches() {
    STATE=$1
    CHECK_SERVER=$2
    CHECK_PORT=$3

    printf '%s\n' "$STATE" | grep -qi 'Enabled: Yes' || return 1
    printf '%s\n' "$STATE" | grep -qiE "^[[:space:]]*Server:[[:space:]]*${CHECK_SERVER}[[:space:]]*$" || return 1
    printf '%s\n' "$STATE" | grep -qE "^[[:space:]]*Port:[[:space:]]*${CHECK_PORT}[[:space:]]*$"
}

# The bypass list of one network service as a sorted, newline-separated string (empty when unset).
get_bypass() {
    networksetup -getproxybypassdomains "$1" 2>/dev/null \
        | tr ',' '\n' \
        | tr -d '()"' \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
        | grep -v '^$' \
        | LC_ALL=C sort
}

# True when every enabled network service already has the http/https/socks proxy enabled on
# host:port with the same bypass list, i.e. applying the proxy again would change nothing.
already_applied() {
    CHECK_SERVER=$1
    CHECK_PORT=$2
    shift 2

    WANT_BYPASS=$(printf '%s\n' "$@" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | LC_ALL=C sort)

    found_service=0
    while IFS= read -r SERVICE; do
        [ -z "$SERVICE" ] && continue
        found_service=1

        state_matches "$(networksetup -getwebproxy "$SERVICE" 2>/dev/null)" "$CHECK_SERVER" "$CHECK_PORT" || return 1
        state_matches "$(networksetup -getsecurewebproxy "$SERVICE" 2>/dev/null)" "$CHECK_SERVER" "$CHECK_PORT" || return 1
        state_matches "$(networksetup -getsocksfirewallproxy "$SERVICE" 2>/dev/null)" "$CHECK_SERVER" "$CHECK_PORT" || return 1
        [ "$(get_bypass "$SERVICE")" = "$WANT_BYPASS" ] || return 1
    done <<< "$(get_services)"

    [ "$found_service" -eq 1 ]
}

# True when at least one enabled network service still has a proxy switched on.
any_proxy_enabled() {
    while IFS= read -r SERVICE; do
        [ -z "$SERVICE" ] && continue
        for FLAG in -getwebproxy -getsecurewebproxy -getsocksfirewallproxy; do
            if networksetup "$FLAG" "$SERVICE" 2>/dev/null | grep -qi 'Enabled: Yes'; then
                return 0
            fi
        done
    done <<< "$(get_services)"

    return 1
}

# Check one "-get..." report: the proxy must be enabled and point at our port.
state_is_enabled_at_port() {
    STATE=$1
    CHECK_PORT=$2

    printf '%s\n' "$STATE" | grep -qi 'Enabled: Yes' || return 1
    printf '%s\n' "$STATE" | grep -qE "Port:[[:space:]]*${CHECK_PORT}$"
}

# networksetup can exit 0 while leaving the settings unchanged, so read the state back and
# require it on at least one enabled service before declaring success.
verify_proxy() {
    CHECK_PORT=$1

    while IFS= read -r SERVICE; do
        [ -z "$SERVICE" ] && continue
        WEB_STATE=$(networksetup -getwebproxy "$SERVICE" 2>/dev/null)
        SOCKS_STATE=$(networksetup -getsocksfirewallproxy "$SERVICE" 2>/dev/null)
        if state_is_enabled_at_port "$WEB_STATE" "$CHECK_PORT" || state_is_enabled_at_port "$SOCKS_STATE" "$CHECK_PORT"; then
            echo "Verified: proxy is active for network service '$SERVICE'."
            return 0
        fi
    done <<< "$(get_services)"

    return 1
}

# Function to set proxy
set_proxy() {
    PROXY_IP=$1
    PROXY_PORT=$2

    shift 2
    BYPASS_DOMAINS=("$@")

    # Get all enabled network service names
    SERVICES=$(get_services)
    if [ -z "$SERVICES" ]; then
        echo "Error: no enabled network services found." >&2
        exit 1
    fi

    # Read-only check first: an unchanged apply never needs root, so a restart of v2rayN on a
    # Mac that already has the proxy set asks the user for nothing.
    if already_applied "$PROXY_IP" "$PROXY_PORT" "${BYPASS_DOMAINS[@]}"; then
        echo "No change needed: every network service already proxies to $PROXY_IP:$PROXY_PORT, no administrator password required."
        return 0
    fi

    require_password_or_exit

    local rc=0
    # Loop through each network service
    while IFS= read -r SERVICE; do
        [ -z "$SERVICE" ] && continue
        echo "Setting proxy for network service '$SERVICE'..."
        # Set HTTP proxy
        run_sudo networksetup -setwebproxy "$SERVICE" "$PROXY_IP" "$PROXY_PORT" || rc=1
        # Set HTTPS proxy
        run_sudo networksetup -setsecurewebproxy "$SERVICE" "$PROXY_IP" "$PROXY_PORT" || rc=1
        # Set SOCKS proxy
        run_sudo networksetup -setsocksfirewallproxy "$SERVICE" "$PROXY_IP" "$PROXY_PORT" || rc=1
        # Set bypass domains
        if [ ${#BYPASS_DOMAINS[@]} -eq 0 ]; then
            # Passing a single empty argument is rejected by some macOS versions,
            # so clear the bypass list explicitly instead.
            run_sudo networksetup -setproxybypassdomains "$SERVICE" || rc=1
        else
            run_sudo networksetup -setproxybypassdomains "$SERVICE" "${BYPASS_DOMAINS[@]}" || rc=1
        fi
    done <<< "$SERVICES"

    if [ $rc -ne 0 ]; then
        echo "Error: one or more networksetup commands failed (check the administrator password)." >&2
        exit 1
    fi

    if ! verify_proxy "$PROXY_PORT"; then
        echo "Error: verification failed - networksetup does not report an enabled proxy on port $PROXY_PORT." >&2
        exit 1
    fi

    echo "Proxy settings for all network services are complete!"
}

# Function to disable proxy
clear_proxy() {
    # Get all enabled network service names
    SERVICES=$(get_services)
    if [ -z "$SERVICES" ]; then
        echo "Error: no enabled network services found." >&2
        exit 1
    fi

    # Nothing switched on anywhere (the usual state when the system proxy was never applied or
    # was already cleared): clearing needs no root and no password.
    if ! any_proxy_enabled; then
        echo "No change needed: no network service has a proxy enabled, no administrator password required."
        return 0
    fi

    require_password_or_exit

    local rc=0
    # Loop through each network service
    while IFS= read -r SERVICE; do
        [ -z "$SERVICE" ] && continue
        echo "Disabling proxy and clearing bypass domains for network service '$SERVICE'..."
        # Disable HTTP proxy
        run_sudo networksetup -setwebproxystate "$SERVICE" off || rc=1
        # Disable HTTPS proxy
        run_sudo networksetup -setsecurewebproxystate "$SERVICE" off || rc=1
        # Disable SOCKS proxy
        run_sudo networksetup -setsocksfirewallproxystate "$SERVICE" off || rc=1
        # Read the state back for the log (a no-op clear is not an error).
        echo "HTTP proxy state: $(networksetup -getwebproxy "$SERVICE" 2>/dev/null | tr '\n' ' ')"
    done <<< "$SERVICES"

    if [ $rc -ne 0 ]; then
        echo "Error: one or more networksetup commands failed (check the administrator password)." >&2
        exit 1
    fi
    echo "Proxy for all network services has been disabled!"
}

# Main script logic
if [ "$1" == "set" ]; then
    # Check if enough parameters are passed for setting proxy
    if [ "$#" -lt 3 ]; then
        echo "Usage: $0 set <IP Address> <Port> [Bypass Domain 1 Bypass Domain 2 ...]"
        exit 1
    fi
    set_proxy "$2" "$3" "${@:4}"
elif [ "$1" == "clear" ]; then
    clear_proxy
else
    echo "Usage:"
    echo "  To set proxy:    $0 set <IP Address> <Port> [Bypass Domain 1 Bypass Domain 2 ...]"
    echo "  To clear proxy: $0 clear"
    exit 1
fi
